# Base URL for the AreaScan API (versioned). On the host machine the API is
# reachable at localhost:8000; inside docker-compose use the service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Browser-side Google Maps JavaScript API key (restricted to your domains).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Map ID (a vector/styled map). When set, the app uses the modern
# AdvancedMarkerElement; otherwise it falls back to google.maps.Marker.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
