# ============================================================================
# AreaScan — environment configuration guide (ROOT)
# ============================================================================
# This repo uses PER-APP env files. Do NOT put real secrets here — this file is
# only a map of which variables live where. Copy each app template, then fill in.
#
#   cp apps/api/.env.example apps/api/.env      # backend
#   cp apps/web/.env.example apps/web/.env      # frontend
#
# When running via `docker compose up`, sane dev defaults are already injected
# by docker-compose.yml. You only need real values for the external API keys
# (Anthropic, Google Maps, Google OAuth) — set those in your shell or a root
# .env that docker compose reads:
#
#   ANTHROPIC_API_KEY=...
#   GOOGLE_MAPS_SERVER_KEY=...
#   GOOGLE_OAUTH_CLIENT_ID=...
#   NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...
#   NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=...   # optional: vector Map ID -> AdvancedMarkerElement
#
# ----------------------------------------------------------------------------
# Backend (apps/api/.env) — see apps/api/.env.example for the full template
# ----------------------------------------------------------------------------
#   ENV=dev                          # dev | uat | prod
#   DATABASE_URL=postgresql+asyncpg://areascan:areascan@db:5432/areascan
#   SYNC_DATABASE_URL=postgresql+psycopg://areascan:areascan@db:5432/areascan
#   REDIS_URL=redis://redis:6379/0
#   JWT_SECRET=change-me
#   ACCESS_TOKEN_TTL_MIN=15
#   REFRESH_TOKEN_TTL_DAYS=7
#   CORS_ORIGINS=http://localhost:3000
#   ANTHROPIC_API_KEY=
#   GOOGLE_MAPS_SERVER_KEY=
#   GOOGLE_OAUTH_CLIENT_ID=
#
# NOTE: inside docker-compose the DB/Redis hosts are 'db' and 'redis'.
#       Running the API directly on your host? Use 'localhost' instead:
#         DATABASE_URL=postgresql+asyncpg://areascan:areascan@localhost:5432/areascan
#         SYNC_DATABASE_URL=postgresql+psycopg://areascan:areascan@localhost:5432/areascan
#         REDIS_URL=redis://localhost:6379/0
#
# ----------------------------------------------------------------------------
# Frontend (apps/web/.env) — see apps/web/.env.example for the full template
# ----------------------------------------------------------------------------
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
#   NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
#   NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=      # optional (vector map / advanced markers)
# ============================================================================
