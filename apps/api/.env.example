# ---------------------------------------------------------------------------
# AreaScan API — environment variables
# Copy to `.env` and fill in real secrets. Never commit `.env`.
# Inside docker-compose, DB/redis hosts are `db` / `redis`.
# On the host machine they are `localhost`.
# ---------------------------------------------------------------------------

# Runtime environment: dev | uat | prod
ENV=dev

# Async driver (used by the app at runtime)
DATABASE_URL=postgresql+asyncpg://areascan:areascan@db:5432/areascan

# Sync driver (used by Alembic migrations only)
SYNC_DATABASE_URL=postgresql+psycopg://areascan:areascan@db:5432/areascan

# Redis
REDIS_URL=redis://redis:6379/0

# Auth / JWT
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Third-party API keys
ANTHROPIC_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
